# openfeed environment. Copy to `.env` (gitignored). Only PUBLIC_-prefixed vars are
# exposed to the browser islands (Astro/Vite rule) — everything here is client-side,
# so all of it is PUBLIC_. None of these are secrets: the project id + endpoint are
# public by design, and owner actions are gated by the FeedX admin password at runtime.

# --- FeedX API (owner-mode interactions) ------------------------------------
# Base URL of the FeedX API (no trailing slash), e.g. https://feedx.example.com
# Owner mode logs in against {PUBLIC_FEEDX_API_URL}/login and POSTs interactions
# with a Bearer token. Leave empty to disable owner interactions entirely.
PUBLIC_FEEDX_API_URL=

# --- Appwrite (live reader count via Presences API) -------------------------
# Reuses the FeedX Appwrite project. Requires:
#   - Appwrite server >= 1.9.5 (Presences API)
#   - a Web platform registered for this site's origin(s) in the Appwrite console
#     (add both http://localhost:4321 for dev and your production domain)
# Anonymous sessions are used, so no API key is exposed. Leave empty to hide the count.
PUBLIC_APPWRITE_ENDPOINT=
PUBLIC_APPWRITE_PROJECT_ID=
