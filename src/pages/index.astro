---
import Layout from '../layouts/Layout.astro';
import DayView from '../components/DayView.astro';
import { getDates, getDay, getLatestDate } from '../lib/feeds.js';

const dates = getDates();
const latest = getLatestDate();
const day = latest ? getDay(latest) : { date: '', items: [], summary: '' };
---

<Layout>
	<DayView day={day} dates={dates} />
</Layout>
